# Copier en .env pour surcharger les valeurs par défaut (le fichier .env n'est pas versionné).

# Réception UDP
PULSEHUB_UDP_HOST=0.0.0.0
PULSEHUB_UDP_PORT=9000

# Diffusion de la synthèse vers le tableau de bord
PULSEHUB_WS_PORT=8080
PULSEHUB_PUBLISH_INTERVAL_MS=250
PULSEHUB_DASHBOARD_PORT=5173

# Synthèse
PULSEHUB_OFFLINE_AFTER_MS=2000
PULSEHUB_RESTART_TOLERANCE_MS=5000
PULSEHUB_THROUGHPUT_WINDOW_MS=2000
PULSEHUB_EVENT_LOG_SIZE=50
PULSEHUB_ALERT_RULES_FILE=config/alert-rules.json
